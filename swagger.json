      "type": "object",
      "properties": {
        "stationId": {
          "type": "string",
          "example": "KSLC"
        },
        "timestamp": {
          "type": "string",
          "example": "2026-08-07T23:30:00Z"
        },
        "temperatureCelsius": {
          "type": "number",
          "example": 24.5
        },
        "windSpeedKnots": {
          "type": "number",
          "example": 12
        },
        "windDirectionDegrees": {
          "type": "number",
          "example": 180
        },
        "visibilityMiles": {
          "type": "number",
          "example": 10
        },
        "flightCategory": {
          "type": "string",
          "example": "VFR"
        },
        "rawMetar": {
          "type": "string",
          "example": "KSLC 072330Z 18012KT 10SM CLR 25/11 A3002"
        }
      }
    },
    "PilotInput": {
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "example": "EMP-9402"
        },
        "firstName": {
          "type": "string",
          "example": "Alex"
        },
        "lastName": {
          "type": "string",
          "example": "Mercer"
        },
        "status": {
          "type": "string",
          "example": "On Duty"
        },
        "certifications": {
          "type": "array",
          "example": [
            "Commercial Pilot",
            "Instrument Rating",
            "Rotorcraft-Helicopter"
          ],
          "items": {
            "type": "string"
          }
        },
        "medicalClassExpiration": {
          "type": "string",
          "example": "2027-04-15"
        },
        "totalFlightHours": {
          "type": "number",
          "example": 2450
        }
      }
    }
